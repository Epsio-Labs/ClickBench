#!/bin/bash
set -e
export LC_ALL=C.UTF-8
# A/B and multi-build callers set PIVOT_SERVER_BIN to time a specific build;
# otherwise fall back to the in-tree PGO server.
BIN="${PIVOT_SERVER_BIN:-$HOME/pivotdb/benchmarks/target-pgouse/release/pivotdb-server}"
mkdir -p "$PIVOT_CATALOG"
# Compaction is off by default; the benchmark reads a static parquet, so we want
# no background compacter. (--compact-bytes now requires --compact, so passing it
# alone is rejected — just omit both.)
#
# Point the server at $PIVOT_CATALOG using whichever flag this build accepts.
# Oldest builds take `--path <dir>`. Newer ones dropped it and require
# `--metastore <file>` naming that same directory, first in TOML and later in
# YAML. An A/B run times two commits that can straddle either change, so probe
# `--help` rather than hard-code one: that would leave one side unable to start.
if "$BIN" --help 2>&1 | grep -q 'Metastore file (YAML)'; then
    METASTORE="/tmp/pivot-metastore-$PIVOT_PORT.yaml"
    # A single datastore, marked default, so unqualified names resolve to it.
    # `users` is an allowlist once present, and this adapter's psql calls
    # connect as `postgres`, so that name is the one defined here. Trust asks
    # for no password, which is what the non-interactive psql calls need.
    cat > "$METASTORE" <<EOF
datastores:
  default:
    kind: delta
    location: $PIVOT_CATALOG
    default: true
users:
  postgres:
    auth:
      method: trust
EOF
    STORE_ARGS=(--metastore "$METASTORE")
elif "$BIN" --help 2>&1 | grep -q -- '--metastore'; then
    METASTORE="/tmp/pivot-metastore-$PIVOT_PORT.toml"
    # A single datastore, marked default, so unqualified names resolve to it.
    cat > "$METASTORE" <<EOF
[datastore.default]
kind = "delta"
location = "$PIVOT_CATALOG"
default = true
EOF
    STORE_ARGS=(--metastore "$METASTORE")
else
    STORE_ARGS=(--path "$PIVOT_CATALOG")
fi
nohup "$BIN" --bind "127.0.0.1:$PIVOT_PORT" "${STORE_ARGS[@]}" \
    > "/tmp/pivot-server-$PIVOT_PORT.log" 2>&1 &
