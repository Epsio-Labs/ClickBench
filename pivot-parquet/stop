#!/bin/bash
export LC_ALL=C.UTF-8
# Bracket avoids self-match; key on the port so we only kill our own server.
# Which argument carries the port depends on the build ./start probed for: older
# ones take `--bind 127.0.0.1:$PIVOT_PORT`, newer ones take a `--config` (or
# `--metastore`) file whose name we stamp the port into precisely so this match
# keeps working.
pkill -9 -f "[p]ivotdb-server .*(--bind 127\.0\.0\.1:$PIVOT_PORT|pivot-(config|metastore)-$PIVOT_PORT\.)" 2>/dev/null || true
